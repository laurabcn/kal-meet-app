# Entorn de test. Es commiteja: aquí no hi va cap secret.
APP_ENV=test
APP_DEBUG=1
APP_SECRET=test_secret
DEFAULT_URI=http://localhost
CORS_ALLOW_ORIGIN='^https?://localhost$'

# DELIBERADAMENT inabastable. Cap test ha de tocar Postgres: als tests el port
# KalRepositoryInterface apunta a InMemoryKalRepository (config/services_test.yaml).
# Si algun test acaba obrint una connexió, ha de petar aquí i no arribar mai a
# la BD local ni, molt menys, a la remota.
DATABASE_URL=postgresql://unreachable:unreachable@127.0.0.1:1/nowhere?serverVersion=15&charset=utf8

# L'ÚNICA excepció, i no la fa servir el container de Symfony: la suite `db`
# (phpunit.db.xml.dist, `make test-db`) es construeix la seva connexió a mà cap
# a la Supabase local, amb l'esquema real de supabase/migrations/. Els tests hi
# treballen dins d'una transacció que sempre es desfà, o sigui que no hi deixen
# res. Credencials per defecte de `supabase start`: locals, mai producció.
TEST_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres?serverVersion=15&charset=utf8

# Auth. Valors fixos i inventats: els tokens dels tests es signen amb claus de
# test i s'han d'emetre amb aquest issuer/audience. La URL del JWKS també és
# inabastable a propòsit — cap test ha de sortir a la xarxa; qui necessiti
# claus substitueix JwksFetcherInterface al container de test.
SUPABASE_JWKS_URL=http://127.0.0.1:1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://test-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_TTL=300
LOG_LEVEL=INFO
SLACK_DSN=null://null

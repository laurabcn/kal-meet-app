<?xml version="1.0" encoding="UTF-8"?>
<!--
    Suite `integration`: els únics tests que toquen Postgres de veritat, contra
    la Supabase local amb l'esquema real de supabase/migrations/. Config a part
    perquè `make qa` segueixi sent hermètic i no depengui de tenir la BD
    aixecada; aquests es corren amb `make test-db` quan es toca persistència.

    Exigeixen `supabase start` i, la primera vegada, `supabase db reset`. Si no
    hi poden connectar FALLEN, no se salten: si has demanat córrer-los és que
    els vols córrer.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.db.cache"
>
    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <server name="APP_ENV" value="test" force="true"/>
        <server name="KERNEL_CLASS" value="App\Kernel"/>
    </php>

    <testsuites>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <!--
        Les MATEIXES exclusions que `phpunit.xml.dist` (allà hi ha el perquè de
        cadascuna). `make coverage` fusiona les dues execucions amb phpcov i
        cada .cov només porta el que la seva config ha analitzat: si divergeixen,
        el resultat fusionat torna a comptar el que l'altra exclou.
    -->
    <source>
        <include>
            <directory>src</directory>
        </include>
        <exclude>
            <directory>src/Shared/Infrastructure/Symfony/Bus/Serializer</directory>
            <directory>src/Shared/Infrastructure/Symfony/Bus/Factory</directory>
            <directory>src/Shared/Infrastructure/Symfony/Bus/Stamp</directory>
            <directory>src/Shared/Application/Message</directory>
            <file>src/Shared/Infrastructure/Symfony/Bus/SymfonyDomainEventBus.php</file>
            <file>src/Shared/Infrastructure/Symfony/Bus/SymfonyExternalMessageBus.php</file>
            <file>src/Shared/Domain/ValueObject/BooleanValue.php</file>
            <file>src/Shared/Domain/ValueObject/PositiveIntegerValue.php</file>
            <file>src/Kal/Domain/FileUploadStatus.php</file>
        </exclude>
    </source>
</phpunit>

{
    "name": "laurabcn/kal-meet-app",
    "description": "KAL App backend — web tool for knit-along organizers",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.0",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/dotenv": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/messenger": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/uid": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "runtime": {
            "class": "Symfony\\Component\\Runtime\\SymfonyRuntime"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

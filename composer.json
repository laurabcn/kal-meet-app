{
    "name": "laurabcn/kal-meet-app",
    "description": "KAL App backend — web tool for knit-along organizers",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.0",
        "firebase/php-jwt": "^7.1",
        "nelmio/cors-bundle": "^2.6",
        "symfony/cache": "^8.1",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/dotenv": "^8.0",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/messenger": "^8.0",
        "symfony/monolog-bundle": "^4.0",
        "symfony/notifier": "^8.1",
        "symfony/property-access": "^8.1",
        "symfony/property-info": "^8.1",
        "symfony/runtime": "^8.0",
        "symfony/security-bundle": "^8.1",
        "symfony/slack-notifier": "^8.1",
        "symfony/uid": "^8.0",
        "symfony/validator": "^8.1",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1",
        "symfony/browser-kit": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "runtime": {
            "class": "Symfony\\Component\\Runtime\\SymfonyRuntime"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}

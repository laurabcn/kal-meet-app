APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me

# Base URI for URL generation outside HTTP (CLI, Messenger). Matches local nginx.
DEFAULT_URI=http://localhost:8080

# Allowed Origin(s) for the Vue frontend (regex). Adjust for deployed FE hosts.
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# Postgres connection string (Supabase → Project settings → Database).
# serverVersion is also set in config/packages/doctrine.yaml (required by DBAL 4).
# Local example: postgresql://postgres:postgres@host.docker.internal:54322/postgres
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Supabase project URL and keys (Supabase → Project settings → API).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Segons que es cachegen les claus públiques del JWKS abans de refrescar-les.
SUPABASE_JWKS_TTL=300
# Service role / secret key. Backend-only, bypasses RLS — keep it out of the frontend.
SUPABASE_SECRET_KEY=

# Optional. One of: DEBUG, INFO, WARNING, ERROR. Defaults to INFO.
LOG_LEVEL=INFO

# Slack alerts for ERROR+ (5xx from the exception subscriber). Bot token with
# chat:write, invited to #alertas. Channel name without #.
# Example: slack://xoxb-your-token@default?channel=alertas
# Disabled by default:
SLACK_DSN=null://null
